{
  "bsonType": "object",
  "required": ["staff_id", "room_id", "service_id"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成",
      "bsonType": "string"
    },
    "staff_id": {
      "description": "技师ID",
      "bsonType": "string"
    },
    "staff_name": {
      "description": "技师姓名",
      "bsonType": "string"
    },
    "room_id": {
      "description": "房间ID",
      "bsonType": "string"
    },
    "room_name": {
      "description": "房间名称",
      "bsonType": "string"
    },
    "service_id": {
      "description": "服务项目ID",
      "bsonType": "string"
    },
    "service_name": {
      "description": "服务名称",
      "bsonType": "string"
    },
    "price": {
      "description": "项目金额",
      "bsonType": "number"
    },
    "duration": {
      "description": "项目时长（分钟）",
      "bsonType": "number"
    },
    "start_time": {
      "description": "上钟时间",
      "bsonType": "timestamp"
    },
    "end_time": {
      "description": "预计下钟时间",
      "bsonType": "timestamp"
    },
    "actual_end_time": {
      "description": "实际下钟时间",
      "bsonType": "timestamp"
    },
    "status": {
      "description": "状态：0-进行中 1-已完成 2-已支付 -1-已取消",
      "bsonType": "number",
      "defaultValue": 0
    },
    "customer_name": {
      "description": "顾客姓名",
      "bsonType": "string"
    },
    "customer_phone": {
      "description": "顾客手机号",
      "bsonType": "string"
    },
    "remark": {
      "description": "备注",
      "bsonType": "string"
    },
    "operator_id": {
      "description": "操作人ID",
      "bsonType": "string"
    },
    "_add_time": {
      "description": "创建时间",
      "bsonType": "timestamp",
      "forceDefaultValue": { "$env": "now" }
    }
  },
  "version": "0.0.1"
}
