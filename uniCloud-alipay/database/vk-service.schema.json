{
  "bsonType": "object",
  "required": ["name", "price", "duration"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成",
      "bsonType": "string"
    },
    "name": {
      "description": "服务名称",
      "bsonType": "string"
    },
    "price": {
      "description": "金额（元）",
      "bsonType": "number"
    },
    "duration": {
      "description": "时长（分钟）",
      "bsonType": "number"
    },
    "status": {
      "description": "状态：true-启用 false-禁用",
      "bsonType": "bool",
      "defaultValue": true
    },
    "_add_time": {
      "description": "创建时间",
      "bsonType": "timestamp",
      "forceDefaultValue": { "$env": "now" }
    }
  },
  "version": "0.0.1"
}
