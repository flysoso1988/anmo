{
  "bsonType": "object",
  "required": ["name"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成",
      "bsonType": "string"
    },
    "name": {
      "description": "房间名称",
      "bsonType": "string"
    },
    "type": {
      "description": "房间类型：0-普通 1-VIP",
      "bsonType": "number",
      "defaultValue": 0
    },
    "status": {
      "description": "状态：0-空闲 1-使用中 2-清理中",
      "bsonType": "number",
      "defaultValue": 0
    },
    "_add_time": {
      "description": "创建时间",
      "bsonType": "timestamp",
      "forceDefaultValue": { "$env": "now" }
    }
  },
  "version": "0.0.1"
}
